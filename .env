# Configuración de Conexión PuntoCell API
# Si el backend corre en Docker: puerto 3003 (ej. http://192.168.100.131:3003/api)
# Si el backend corre local (npm run dev): puerto 3000 (ej. http://192.168.100.131:3000/api)
EXPO_PUBLIC_API_URL=http://192.168.100.131:3003/api
EXPO_PUBLIC_JWT_SECRET=una_clave_secreta_larga_minimo_8_chars
